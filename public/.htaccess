# Position Xero — Apache config (Hostinger)

# Serve the branded 404 page with a real 404 status (avoids soft-404s).
ErrorDocument 404 /404.html
# Gone pages (12 November 2026) answer 410 with the same branded page.
ErrorDocument 410 /404.html

# ---------------------------------------------------------------------------
# NEVER serve internal/source files. pricing.md is the ONE public .md
# (machine-readable pricing, linked from llms.txt). Everything else that is
# markdown, and the whole /docs/ tree, returns 404.
# ---------------------------------------------------------------------------
RedirectMatch 404 ^/docs(/|$)
RedirectMatch 404 ^/seo-tool(/|$)
RedirectMatch 404 ^/(?!pricing\.md$)[^/]*\.md$
<FilesMatch "\.md$">
  Require all denied
</FilesMatch>
<Files "pricing.md">
  Require all granted
</Files>

# Redirect direct /index.html (and /blog/index.html) hits to the clean canonical URL.
# THE_REQUEST condition prevents loops when Apache serves "/" via DirectoryIndex internally.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ https://www.positionxero.com/$1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# Clean, extensionless URLs (2026-07-12). Canonical URLs no longer carry .html:
# /services.html 301s to /services, and /services is served from services.html.
# index.html/404.html are excluded (handled above / error page).
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # 12 November 2026 (owner): Position Xero sells its four monthly website
  # packages only. The free audit is retired, so /free-audit (and the older
  # /seo-audit, which used to point at it) go to the packages. The services
  # overview goes to the packages, which are now everything we sell. The
  # international web design page goes to the South African one (same service).
  # Ads and lead generation have no service pages: they are offered on the brief
  # from the "Looking for something more?" band under the packages. One hop each,
  # with or without .html or a slash.
  RewriteRule ^free-audit(\.html)?/?$ https://www.positionxero.com/packages [R=301,L]
  RewriteRule ^seo-audit(\.html)?/?$ https://www.positionxero.com/packages [R=301,L]
  RewriteRule ^services(\.html)?/?$ https://www.positionxero.com/packages [R=301,L]
  RewriteRule ^web-design(\.html)?/?$ https://www.positionxero.com/web-design-south-africa [R=301,L]
  RewriteRule ^(ads|google-ads-south-africa|meta-ads-south-africa|lead-gen|lead-generation-south-africa)(\.html)?/?$ https://www.positionxero.com/packages#more [R=301,L,NE]
  # Two posts are due to be rewritten under clearer addresses
  # (/blog/hand-built-website-vs-wordpress to /blog/coded-website-vs-wordpress,
  # /blog/conversion-tracking-for-lead-generation to /blog/track-website-enquiries).
  # Their 301s go in only when the rewritten posts are live, so neither rule is
  # here yet: both old addresses still serve their posts.
  #
  # Gone (410), 12 November 2026: the US-market pages (the US offer has ended) and
  # the lead-generation and ads posts, which brought no South African buyers in 180
  # days of Search Console data. The [G] flag answers 410 Gone and stops here.
  RewriteRule ^(lead-generation-dallas|hvac-marketing|roofing-marketing)(\.html)?/?$ - [G]
  RewriteRule ^blog/(are-lead-generation-companies-worth-it|cost-per-lead-benchmarks|exclusive-vs-shared-leads|fake-leads-bot-leads|google-ads-cost-south-africa|google-ads-vs-meta-ads|how-much-are-leads-worth|how-much-do-google-ads-cost|how-much-do-solar-leads-cost|how-much-does-lead-generation-cost|how-to-get-clients-without-buying-leads|how-to-get-hvac-leads-small-company)(\.html)?/?$ - [G]
  RewriteRule ^blog/(is-buying-leads-worth-it|is-lead-generation-a-scam|is-lead-generation-worth-the-investment|law-firm-lead-generation|lead-generation-agency-vs-sales-executive|lead-generation-for-recruitment-agencies|lead-generation-for-small-business|lead-generation-outsourcing-guide|local-services-ads-vs-google-ads|pay-per-lead-vs-retainer|real-estate-lead-generation|roofing-seo-vs-ppc)(\.html)?/?$ - [G]
  # Posts retired on 2026-10-07 used to 301 to posts that are now gone. They are
  # gone too, so they answer 410 directly instead of chaining into one.
  RewriteRule ^blog/(buy-aged-final-expense-leads|buy-mortgage-broker-leads|is-buying-insurance-leads-worth-it|is-it-worth-buying-real-estate-leads|buy-exclusive-roofing-leads|how-to-vet-purchased-leads)(\.html)?/?$ - [G]
  # Common guesses that answered 404 and still drew visits (Clarity, 15 to 28 October 2026):
  # /contact-us goes to /contact and /privacy-policy to /privacy. One hop, with or without
  # .html or a trailing slash (29 October 2026).
  RewriteRule ^contact-us(\.html)?/?$ https://www.positionxero.com/contact [R=301,L]
  RewriteRule ^privacy-policy(\.html)?/?$ https://www.positionxero.com/privacy [R=301,L]
  # 12 November 2026 (owner): /premium, the pick-and-choose custom tier, was dropped the
  # day it was built; anything beyond the packages is now a WhatsApp enquiry from the
  # "Looking for something more?" band under the packages. /works became /work, the
  # full showcase of every site we built. One hop each, with or without .html or a slash.
  RewriteRule ^premium(\.html)?/?$ https://www.positionxero.com/packages#more [R=301,L,NE]
  RewriteRule ^works(\.html)?/?$ https://www.positionxero.com/work [R=301,L]
  # Legacy .html URL requested directly -> 301 to the clean canonical URL.
  # Absolute target: even a URL wrong on host AND scheme AND extension resolves in ONE hop.
  RewriteCond %{REQUEST_URI} !(^|/)(index|404)\.html$ [NC]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ https://www.positionxero.com/%1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# Trailing slash -> clean canonical URL (2026-09-17). /services/ and /services
# both answered 200 before this, and so did /ads/ and /blog/what-is-ai-seo/.
# Every page already carries a canonical tag pointing at the slashless form, so
# the harm was small. A 301 is cleaner.
#
# THE TWO REAL DIRECTORIES WORK THE OPPOSITE WAY ROUND AND MUST NOT BE CAUGHT.
# /blog/ and /careers/ answer 200 while /blog and /careers 301 to the slash
# form, because mod_dir adds the slash to a real directory. A blanket rule would
# fight those two redirects and loop, which takes both sections offline.
#
# Two guards keep them out, and either one is enough on its own:
#   - !-d skips anything that is a real directory on disk.
#   - the DOCUMENT_ROOT/$1.html -f test only fires where the slashless form has
#     an actual page behind it. There is no blog.html and no careers.html, and
#     no directory under public/ has a sibling .html file (checked 2026-09-17).
# The pattern requires a non-empty first segment, so "/" never matches and
# "//services/" is left to the canonical-host block below rather than being
# rewritten into a double slash.
#
# ORDER MATTERS, for the same reason the block below says it does. This sits
# AFTER the .html redirect and BEFORE both the canonical-host block and the
# internal clean-URL rewrite. The target is absolute, so
# http://positionxero.com/services/ reaches https://www.positionxero.com/services
# in ONE hop. Putting it after the internal rewrite would do nothing at all:
# LiteSpeed does not re-run the rules after that rewrite's [L].
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+(?:/[^/]+)*)/$ https://www.positionxero.com/$1 [R=301,L,NE]
</IfModule>

# ---------------------------------------------------------------------------
# Canonical host + HTTPS in a SINGLE hop (matches <link rel="canonical"> and the
# sitemap). Enabled 2026-07-12 to fix the multi-redirect chain PageSpeed flagged
# (0.63s). Loop-proofed: the X-Forwarded-Proto guard covers proxy TLS termination.
#
# ORDER MATTERS (moved here 2026-09-16). This block must sit AFTER the absolute
# redirects above, so /x.html on the bare domain still reaches www/x in one hop,
# and BEFORE the clean-URL internal rewrite below. LiteSpeed does not re-run the
# rules after that rewrite's [L], so while this block sat below it,
# https://positionxero.com/free-audit answered 200 instead of redirecting.
#
# The host redirect reads the path from THE_REQUEST (the line the visitor sent)
# with leading slashes collapsed, so //free-audit does not survive as a duplicate
# and a redirect raised while serving the 404 page keeps the requested path.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Non-canonical host (bare domain, casing variants), or a path starting "//" -> canonical, one hop
  RewriteCond %{HTTP_HOST} !^www\.positionxero\.com$ [NC,OR]
  RewriteCond %{THE_REQUEST} ^\S+\s//
  RewriteCond %{THE_REQUEST} ^\S+\s/+([^\s?]*)
  RewriteRule ^ https://www.positionxero.com/%1 [R=301,L,NE]
  # Fallback for a request line not in "METHOD /path" form
  RewriteCond %{HTTP_HOST} !^www\.positionxero\.com$ [NC]
  RewriteRule ^/*(.*)$ https://www.positionxero.com/$1 [R=301,L]
  # Canonical host over plain HTTP -> HTTPS, one hop
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://www.positionxero.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Clean URL requested -> serve the matching .html file internally
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Long-cache static assets for performance (safe for hashed/owned assets).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript       "access plus 1 month"
  ExpiresByType image/x-icon          "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType font/woff             "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# Long-cache web fonts and icon images as immutable (no revalidation).
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|png|jpg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The files Vite builds into /assets/ carry a hash of their content in the
  # name (main-CwOIiklZ.js), so a changed file always arrives under a new name
  # and a browser can keep the old one for a year (16 October 2026, T-56).
  # FilesMatch sees only the file name, so this matches that hashed pattern,
  # which only /assets/ files have (checked against dist/ the same day); the
  # same rule already runs on other sites on this host. /css/tokens.css,
  # /css/site.css and /js/site.js have no hash and keep their own lifetimes
  # and the ?v= bump.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages at the CDN edge (18 October 2026). Without a Cache-Control header
  # Hostinger's CDN marks every page DYNAMIC and fetches it from the server on
  # each request (x-hcdn-cache-status: DYNAMIC, x-hcdn-upstream-rt 0.16s from
  # the Johannesburg edge, further from overseas), which an audit scored as a
  # slow 0.72s server response. "public" plus s-maxage lets the edge hold a page
  # for a day, so even a quiet page is still at a far edge when the next visitor
  # or audit arrives; max-age=0 keeps browsers revalidating. A deploy clears the
  # edge: checked live twice on 18 October 2026, both Johannesburg edge nodes
  # dropped the old copy within about a minute of the new files landing. If a
  # deploy ever does not show after a couple of minutes, check
  # `x-hcdn-cache-status` and `age`, then flush the CDN in hPanel (Websites,
  # Performance, CDN).
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, s-maxage=86400"
  </FilesMatch>
  # LiteSpeed applies the rule above to the branded 404 too (checked live the
  # same day), and a 404 held at the edge would hide a newly published page.
  # no-cache keeps it out of the CDN; this block must stay below the one above
  # so it wins.
  <Files "404.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# Compress text assets.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain font/woff2 font/woff application/font-woff2 text/markdown application/manifest+json
</IfModule>

# Security / response headers (safe, code-only — no rendering changes).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # HSTS (T-51, 12 Nov 2026): browsers keep to https for a year. No
  # includeSubDomains and no preload, so a subdomain without https is never
  # locked out.
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
