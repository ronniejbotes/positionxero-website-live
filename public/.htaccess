# Position Xero — Apache config (Hostinger)

# Serve the branded 404 page with a real 404 status (avoids soft-404s).
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# NEVER serve internal/source files. pricing.md is the ONE public .md
# (machine-readable pricing, linked from llms.txt). Everything else that is
# markdown, and the whole /docs/ tree, returns 404.
# ---------------------------------------------------------------------------
RedirectMatch 404 ^/docs(/|$)
RedirectMatch 404 ^/seo-tool(/|$)
RedirectMatch 404 ^/(?!pricing\.md$)[^/]*\.md$
<FilesMatch "\.md$">
  Require all denied
</FilesMatch>
<Files "pricing.md">
  Require all granted
</Files>

# Redirect direct /index.html (and /blog/index.html) hits to the clean canonical URL.
# THE_REQUEST condition prevents loops when Apache serves "/" via DirectoryIndex internally.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ https://www.positionxero.com/$1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# Clean, extensionless URLs (2026-07-12). Canonical URLs no longer carry .html:
# /services.html 301s to /services, and /services is served from services.html.
# index.html/404.html are excluded (handled above / error page).
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # /seo-audit was replaced by /free-audit before ever shipping (2026-07-13) — catch strays in one hop.
  RewriteRule ^seo-audit(\.html)?$ https://www.positionxero.com/free-audit [R=301,L]
  # Legacy .html URL requested directly -> 301 to the clean canonical URL.
  # Absolute target: even a URL wrong on host AND scheme AND extension resolves in ONE hop.
  RewriteCond %{REQUEST_URI} !(^|/)(index|404)\.html$ [NC]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ https://www.positionxero.com/%1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# Trailing slash -> clean canonical URL (2026-09-17). /services/ and /services
# both answered 200 before this, and so did /ads/ and /blog/what-is-ai-seo/.
# Every page already carries a canonical tag pointing at the slashless form, so
# the harm was small. A 301 is cleaner.
#
# THE TWO REAL DIRECTORIES WORK THE OPPOSITE WAY ROUND AND MUST NOT BE CAUGHT.
# /blog/ and /careers/ answer 200 while /blog and /careers 301 to the slash
# form, because mod_dir adds the slash to a real directory. A blanket rule would
# fight those two redirects and loop, which takes both sections offline.
#
# Two guards keep them out, and either one is enough on its own:
#   - !-d skips anything that is a real directory on disk.
#   - the DOCUMENT_ROOT/$1.html -f test only fires where the slashless form has
#     an actual page behind it. There is no blog.html and no careers.html, and
#     no directory under public/ has a sibling .html file (checked 2026-09-17).
# The pattern requires a non-empty first segment, so "/" never matches and
# "//services/" is left to the canonical-host block below rather than being
# rewritten into a double slash.
#
# ORDER MATTERS, for the same reason the block below says it does. This sits
# AFTER the .html redirect and BEFORE both the canonical-host block and the
# internal clean-URL rewrite. The target is absolute, so
# http://positionxero.com/services/ reaches https://www.positionxero.com/services
# in ONE hop. Putting it after the internal rewrite would do nothing at all:
# LiteSpeed does not re-run the rules after that rewrite's [L].
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+(?:/[^/]+)*)/$ https://www.positionxero.com/$1 [R=301,L,NE]
</IfModule>

# ---------------------------------------------------------------------------
# Canonical host + HTTPS in a SINGLE hop (matches <link rel="canonical"> and the
# sitemap). Enabled 2026-07-12 to fix the multi-redirect chain PageSpeed flagged
# (0.63s). Loop-proofed: the X-Forwarded-Proto guard covers proxy TLS termination.
#
# ORDER MATTERS (moved here 2026-09-16). This block must sit AFTER the absolute
# redirects above, so /x.html on the bare domain still reaches www/x in one hop,
# and BEFORE the clean-URL internal rewrite below. LiteSpeed does not re-run the
# rules after that rewrite's [L], so while this block sat below it,
# https://positionxero.com/free-audit answered 200 instead of redirecting.
#
# The host redirect reads the path from THE_REQUEST (the line the visitor sent)
# with leading slashes collapsed, so //free-audit does not survive as a duplicate
# and a redirect raised while serving the 404 page keeps the requested path.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Non-canonical host (bare domain, casing variants), or a path starting "//" -> canonical, one hop
  RewriteCond %{HTTP_HOST} !^www\.positionxero\.com$ [NC,OR]
  RewriteCond %{THE_REQUEST} ^\S+\s//
  RewriteCond %{THE_REQUEST} ^\S+\s/+([^\s?]*)
  RewriteRule ^ https://www.positionxero.com/%1 [R=301,L,NE]
  # Fallback for a request line not in "METHOD /path" form
  RewriteCond %{HTTP_HOST} !^www\.positionxero\.com$ [NC]
  RewriteRule ^/*(.*)$ https://www.positionxero.com/$1 [R=301,L]
  # Canonical host over plain HTTP -> HTTPS, one hop
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://www.positionxero.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Clean URL requested -> serve the matching .html file internally
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Long-cache static assets for performance (safe for hashed/owned assets).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/x-icon          "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType font/woff             "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# Long-cache web fonts and icon images as immutable (no revalidation).
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|png|jpg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Compress text assets.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain font/woff2 font/woff application/font-woff2 text/markdown application/manifest+json
</IfModule>

# Security / response headers (safe, code-only — no rendering changes).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
